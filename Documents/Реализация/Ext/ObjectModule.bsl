
Процедура ОбработкаПроведения(Отказ, Режим)
	//{{__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!

	// регистр ОстаткиТоваров Приход
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.СтоимостьТоваров.Записывать = Истина;
	Движения.Продажи.Записывать = Истина;
	
	
	Для Каждого ТекСтрокаПереченьТоваров Из ПереченьТоваров Цикл 
		

		Если ТекСтрокаПереченьТоваров.Товар.ВидТовара=Перечисления.ВидыТоваров.Товар тогда	
			
			
		
			  
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Товар = ТекСтрокаПереченьТоваров.Товар;
		Движение.Склад = Склад;
		Движение.Количество = ТекСтрокаПереченьТоваров.Количество; 
		
		// регистр СтоимостьМатериалов Расход
Движение = Движения.СтоимостьТоваров.Добавить();
Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
Движение.Период = Дата;
Движение.Товар = ТекСтрокаПереченьТоваров.Товар;
Движение.Стоимость = ТекСтрокаПереченьТоваров.Количество * 
       ТекСтрокаПереченьТоваров.Стоимость;
		
		КонецЕсли;
		
		// Регистр Продажи 
Движение = Движения.Продажи.Добавить();
Движение.Период = Дата;
Движение.Товары = ТекСтрокаПереченьТоваров.Товар;
Движение.Контрагенты = Контрагент;
Движение.Мастер = Мастер;
Движение.Количество = ТекСтрокаПереченьТоваров.Количество;
Движение.Выручка = ТекСтрокаПереченьТоваров.Сумма;
Движение.Стоимость = ТекСтрокаПереченьТоваров.Стоимость * 
       ТекСтрокаПереченьТоваров.Количество;
		
		
	КонецЦикла;

	//}}__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ
КонецПроцедуры




Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
 Индекс = ПроверяемыеРеквизиты.Найти("ПереченьТоваров.НаборСвойств");
 Если Индекс <> Неопределено Тогда
  ПроверяемыеРеквизиты.Удалить(Индекс);
 КонецЕсли; 
 Индекс = 0; 
 
 Для Каждого ТекСтрокаПереченьТоваров Из ПереченьТоваров Цикл
  Если ТекСтрокаПереченьТоваров.Товар.ВидТовара = Перечисления.ВидыТоваров.Товар  Тогда 
   Если Не ЗначениеЗаполнено(ТекСтрокаПереченьТоваров.НаборСвойств) 
               Тогда
    Сообщение = Новый СообщениеПользователю();
    Сообщение.Текст = "В строке " + Строка(Индекс+1) +" списка Перечень товаров не заполнена колонка Набор свойств";
    Сообщение.Поле = "ПереченьТоваров[" + Строка(Индекс) 
       + "].НаборСвойств";
    Сообщение.УстановитьДанные(ЭтотОбъект);
    Сообщение.Сообщить();
    Отказ = Истина;
   КонецЕсли;
  КонецЕсли;
  Индекс = Индекс + 1;
 КонецЦикла;
КонецПроцедуры
